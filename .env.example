# Copy to .env and fill in. Never commit .env, and never put a real key here.
#
# Everything below is read by something in this repo; nothing that is read is
# missing. Expo loads this file automatically and Metro inlines the
# EXPO_PUBLIC_* values at build time, so a change here needs a restart, not a
# reload. There is no mock-data mode and no offline mode: the demo entry point
# and the sample data were deleted on 30 Aug 2026 (docs/LAUNCH-CHECKLIST.md
# §10), and `USE_SUPABASE` is a hardcoded `true` in src/lib/config.ts that reads
# no variable. The two values in the first block are required.
#
# EAS builds do not use this file — each profile in eas.json carries its own
# env block. Adding a variable here that a build needs does nothing until it is
# added there too.
#
# Every optional value below is left EMPTY on purpose, so that copying this file
# unedited gives you an app that says a feature is not set up rather than one
# that claims it is and then fails at the vendor. An empty value is read exactly
# as an absent one (src/lib/planOffer.ts).

# ── Required: without both of these the app builds and then crashes on launch
#    with `supabaseUrl is required` (src/lib/supabase.ts). ──────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ── Which app this build is. Both are optional and both have a default. ─────
# client | trainer | owner — decides the reachable route group and the native
# bundle id. Unset means client. src/lib/variant.ts, app.config.ts.
EXPO_PUBLIC_APP_VARIANT=client
# Whose name is on it. Unset means repple. Setting this to an unknown id falls
# back to repple rather than failing. src/lib/brands.ts, docs/WHITE-LABEL.md.
EXPO_PUBLIC_BRAND=repple

# ── Features that are simply absent when their variable is unset. ───────────
# `1` turns on the AI food parser and the AI coach; anything else and
# foodAIAvailable() and coachAvailable() return false and those screens offer
# nothing. Photo/InBody reading is on regardless, because it also switches on
# USE_SUPABASE. src/lib/foodAI.ts, src/lib/coach.ts, src/lib/vision.ts.
EXPO_PUBLIC_ENABLE_VISION=1
# Without it, connecting Spotify reports "Spotify isn't set up in this build".
# src/lib/spotify.ts (also mirrored into app.json `extra`).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# Without each one, that vendor cannot be connected on the Devices screen and
# says so. The client *secret* for each is a Supabase secret, never here.
# src/lib/wearables/oauthConfig.ts.
EXPO_PUBLIC_OURA_CLIENT_ID=
EXPO_PUBLIC_WHOOP_CLIENT_ID=
# Read, but shipped empty in every profile: Fitbit is unfinished and Garmin
# needs an approved partnership and OAuth1.0a, so setting these alone is not
# enough to make either work.
EXPO_PUBLIC_FITBIT_CLIENT_ID=
EXPO_PUBLIC_GARMIN_CLIENT_ID=
# The Meta app id. Without it, connecting an ad account is refused with a
# reason. Its secret is the META_ADS_CLIENT_SECRET Supabase secret.
# src/ui/adSpend.ts.
EXPO_PUBLIC_META_ADS_CLIENT_ID=
# Stripe price id per platform plan. A plan with no price id cannot be
# subscribed to, and billing stays hidden until at least one is set. No eas.json
# profile sets these yet. src/lib/billing.ts, src/lib/planOffer.ts.
EXPO_PUBLIC_STRIPE_PRICE_STARTER=
EXPO_PUBLIC_STRIPE_PRICE_PRO=
EXPO_PUBLIC_STRIPE_PRICE_STUDIO=

# ── Not shipped in the app. Read from this file by scripts/check-schema.mjs,
#    which parses .env itself. Optional: without it the live schema check still
#    runs, but it can only confirm names it already knows and says so instead of
#    claiming full coverage. SUPABASE_SERVICE_ROLE_KEY is accepted as an alias.
#    Never prefix either with EXPO_PUBLIC_ — that would ship it to phones. ────
SUPABASE_SECRET_KEY=

# Edge-function secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# ANTHROPIC_API_KEY, META_ADS_CLIENT_SECRET, the wearable *_CLIENT_SECRETs, …)
# are read with Deno.env inside supabase/functions and are set with
# `supabase secrets set`. Putting them in this file does nothing.
