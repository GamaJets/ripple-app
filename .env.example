# Copy to .env and fill in. Never commit .env.
# Set to 1 once Supabase is live to switch the app off mock data onto the real
# backend (see src/data/repo.ts). Leave unset/0 to keep running on mock data.
EXPO_PUBLIC_USE_SUPABASE=0
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
# Server-side only (edge functions) — do NOT prefix with EXPO_PUBLIC:
STRIPE_SECRET_KEY=sk_live_or_test_xxx
