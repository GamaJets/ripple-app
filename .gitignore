node_modules/
.expo/
.tmp/
dist/
.env
*.log
ios/
android/

# transient edit scripts (device fs cannot rm)
.scratch*
.DS_Store
_to_delete/

dist-verify/
.fuse_hidden*
.claude/settings.local.json

# Google Play service-account key. Grants Admin on the Play developer account,
# so it never belongs in the repo — eas.json only points at it by path.
/play-service-account.json
.preflight-export/

# Signing material. Nothing here today — EAS holds the certificates on its own
# servers and none of this exists locally. These patterns are pre-emptive: the
# moment somebody picks a "download" option in `eas credentials`, a .p8 or .p12
# lands in this directory, and a private key committed once is a private key to
# be rotated.
*.p8
*.p12
*.mobileprovision
*.cer
*.keystore
*.jks
credentials.json
# The Google Play submission key, if one is ever added for Android auto-submit.
play-service-account*.json

# Staged output of scripts/import-repdb.mjs. Generated, and deliberately not
# committed: the manifest enumerates every file of a 1.8 GB licensed image
# catalogue, and the RepDB licence forbids making that catalogue available in
# bulk. A file listing is not the assets, but it is the shape of them, and it
# has no reason to be in a repository either way.
.repdb-staging/

# Compiled output must never sit beside its source. A `tsc` run without
# --outDir drops a .js next to every .ts it reads, and on 4 Sep 2026 one of
# those was committed: src/lib/offlineQueue.js, a build artifact shadowing the
# module it was built from. Metro resolves .js before .ts, so a stale one wins
# silently and the app runs code nobody edited.
src/**/*.js
app/**/*.js
src/**/*.js.map
app/**/*.js.map

$S/
