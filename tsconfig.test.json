{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    // "bundler" resolution requires module preserve/es2015+; this config emits
    // commonjs for plain `node` to run, so "node" is the matching resolver.
    // (Previously "bundler", which made tsc exit 2 — and because the npm script
    // is `tsc && node ...`, the tests never actually ran.)
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".tmp",
    "rootDir": "src"
  },
  "files": [
    "src/lib/types.ts",
    "src/lib/nutrition.ts",
    "src/lib/meals.ts",
    "src/lib/booking.ts",
    "src/lib/age.ts",
    "src/lib/format.ts",
    "src/lib/logic.test.ts",
    "src/lib/gymRecord.ts",
    "src/lib/gymSchedule.ts",
    "src/lib/coverage.test.ts"
  ]
}
