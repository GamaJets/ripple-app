{
  "expo": {
    "name": "Repple",
    "slug": "repple",
    "scheme": "repple",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.washateria.repple",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Repple reads your heart rate and calories to log workouts.",
        "NSCameraUsageDescription": "Repple uses the camera to capture InBody scans and progress photos.",
        "NSPhotoLibraryUsageDescription": "Repple lets you upload InBody scans and progress photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.washateria.repple",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Repple reads your heart rate, calories, steps and workouts to track your training."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16b8a6"
        }
      ],
      "expo-web-browser",
      "./plugins/withNoHealthWrite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d4ca6bf-2f1c-4b87-94f4-9b6bdd008aad"
      },
      "EXPO_PUBLIC_WHOOP_CLIENT_ID": "4b281c54-db5e-41fd-9e2c-7c70abc54932",
      "EXPO_PUBLIC_SPOTIFY_CLIENT_ID": "c9bc84b448254e1c831b953d670f1de7",
      "EXPO_PUBLIC_OURA_CLIENT_ID": "b13f6e4a-da3a-43ba-820b-ff1e43306747",
      "EXPO_PUBLIC_FITBIT_CLIENT_ID": "",
      "EXPO_PUBLIC_GARMIN_CLIENT_ID": ""
    },
    "owner": "repple",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d4ca6bf-2f1c-4b87-94f4-9b6bdd008aad"
    }
  }
}
