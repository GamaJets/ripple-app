{
  "expo": {
    "name": "Repple",
    "slug": "repple",
    "scheme": "repple",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.washateria.repple",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Repple reads your heart rate and calories to log workouts.",
        "NSHealthUpdateUsageDescription": "Repple writes completed workouts to Apple Health.",
        "NSCameraUsageDescription": "Repple uses the camera to capture InBody scans and progress photos.",
        "NSPhotoLibraryUsageDescription": "Repple lets you upload InBody scans and progress photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.washateria.repple",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "health.READ_HEART_RATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Repple reads your heart rate, calories, steps and workouts to track your training.",
          "healthUpdatePermission": "Repple writes completed workouts to Apple Health."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d4ca6bf-2f1c-4b87-94f4-9b6bdd008aad"
      }
    },
    "owner": "repple",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d4ca6bf-2f1c-4b87-94f4-9b6bdd008aad"
    }
  }
}
