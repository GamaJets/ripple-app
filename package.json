{
  "name": "repple-app",
  "version": "0.1.0",
  "private": true,
  "description": "Repple \u2014 white-label fitness platform (Expo + Supabase). Production scaffold.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:logic": "tsc -p tsconfig.test.json && node .tmp/lib/logic.test.js",
    "test": "tsc -p tsconfig.test.json && node .tmp/lib/logic.test.js && node .tmp/lib/coverage.test.js",
    "test:coverage": "tsc -p tsconfig.test.json && node .tmp/lib/coverage.test.js",
    "db:build": "node scripts/build-supabase-setup.mjs",
    "db:check": "node scripts/build-supabase-setup.mjs --check",
    "studio": "npm --prefix studio-web run dev"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^57.0.16",
    "expo-auth-session": "~57.0.9",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-updates": "~57.0.17",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health": "^1.19.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "//deferred-native-deps": "Added at the dev-build/EAS stage (they require native code and do NOT run in Expo Go): @stripe/stripe-react-native",
  "//native-deps-in-tree": "Already installed and native, so a dev build is required from here on — Expo Go will not run the app: expo-video (exercise demos play inline; the alternative was Linking.openURL, which sends a client out of the app mid-session and is what lost their typed sets).",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
